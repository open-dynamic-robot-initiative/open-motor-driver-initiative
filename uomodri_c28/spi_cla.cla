#include "AS5047U.h"
#include "cla_shared.h"
#include "f2838x_device.h"
#include "driverlib.h"
#include "uomodri_user_defines.h"
//#include "hal.h"

__interrupt void Cla1Task1 ( void )
{
//    GPIO_writePin(MST_SPI_CS, 0);
    HWREG(GPIODATA_BASE + GPIO_O_GPCCLEAR) = 0x100; //Clear CS

    SPI_writeDataBlockingFIFO(MST_SPI_BASE, ERRFL_REG); //Clear the error register by reading it
    SPI_readDataBlockingFIFO(MST_SPI_BASE);

//    GPIO_writePin(MST_SPI_CS, 1);
    HWREG(GPIODATA_BASE + GPIO_O_GPCSET) = 0x100; //Set CS

    uint8_t     com[2];
    uint32_t    msg[4];
    uint16_t    rData[2];
    uint32_t    i;
    bool_t      crccheck;

    while(1)
    {
        if(!flag)
        {
            crccheck=1;
//          GPIO_writePin(MST_SPI_CS, 0);
            HWREG(GPIODATA_BASE + GPIO_O_GPCCLEAR) = 0x100; //Clear CS

            SPI_writeDataNonBlocking(MST_SPI_BASE, MSB_32(ANGLE_COMMAND));
            SPI_writeDataNonBlocking(MST_SPI_BASE, LSB_32(ANGLE_COMMAND));
            SPI_readDataBlockingFIFO(MST_SPI_BASE);
            SPI_readDataBlockingFIFO(MST_SPI_BASE);

            HWREG(GPIODATA_BASE + GPIO_O_GPCSET) = 0x100; //Set CS
            //GPIO_writePin(MST_SPI_CS, 1);
            for (i=1;i<4;i++)    /*Minimum High time of SS/ between two transmissions is 350ns(According to the AS5047u datasheet) */
                __mnop();
            HWREG(GPIODATA_BASE + GPIO_O_GPCCLEAR) = 0x100; //Clear CS
            //GPIO_writePin(MST_SPI_CS, 0);

            SPI_writeDataNonBlocking(MST_SPI_BASE, MSB_32(VELOCITY_COMMAND));
            SPI_writeDataNonBlocking(MST_SPI_BASE, LSB_32(VELOCITY_COMMAND));
            rData[0]= SPI_readDataBlockingFIFO(MST_SPI_BASE);
            rData[1]= SPI_readDataBlockingFIFO(MST_SPI_BASE);

            HWREG(GPIODATA_BASE + GPIO_O_GPCSET) = 0x100;  //Set CS
            //GPIO_writePin(MST_SPI_CS, 1);
            msg[0]  = FUS_16_TO_32(rData[0], rData[1]);
//            msg[0]=((uint32_t)rData[0] << 16U) |
//                        (uint32_t) rData[1];

            for (i=1;i<6;i++)    /*Minimum High time of SS/ between two transmissions is 350ns(According to the AS5047u datasheet) */
                __mnop();
            HWREG(GPIODATA_BASE + GPIO_O_GPCCLEAR) = 0x100;  //Clear CS
            //GPIO_writePin(MST_SPI_CS, 0);

            SPI_writeDataNonBlocking(MST_SPI_BASE, MSB_32(0x0040001B));
            SPI_writeDataNonBlocking(MST_SPI_BASE, LSB_32(0x0040001B));
            rData[0]= SPI_readDataBlockingFIFO(MST_SPI_BASE);
            rData[1]= SPI_readDataBlockingFIFO(MST_SPI_BASE);

            HWREG(GPIODATA_BASE + GPIO_O_GPCSET) = 0x100;
            //GPIO_writePin(MST_SPI_CS, 1);
            msg[1]  = FUS_16_TO_32(rData[0], rData[1]);
//            msg[1]=((uint32_t)rData[0] << 16U) |
//                        (uint32_t) rData[1];
/**********************************SECOND MOTOR*****************************************/
            for (i=1;i<6;i++)    /*Minimum High time of SS/ between two transmissions is 350ns(According to the AS5047u datasheet) */
                __mnop();
//          GPIO_writePin(MST_SPI_CS, 0);
            HWREG(GPIODATA_BASE + GPIO_O_GPCCLEAR) = 0x100; //Clear CS

            SPI_writeDataNonBlocking(MST_SPI_BASE, MSB_32(ANGLE_COMMAND));
            SPI_writeDataNonBlocking(MST_SPI_BASE, LSB_32(ANGLE_COMMAND));
            SPI_readDataBlockingFIFO(MST_SPI_BASE);
            SPI_readDataBlockingFIFO(MST_SPI_BASE);

            HWREG(GPIODATA_BASE + GPIO_O_GPCSET) = 0x100; //Set CS
            //GPIO_writePin(MST_SPI_CS, 1);
            for (i=1;i<4;i++)    /*Minimum High time of SS/ between two transmissions is 350ns(According to the AS5047u datasheet) */
                __mnop();
            HWREG(GPIODATA_BASE + GPIO_O_GPCCLEAR) = 0x100; //Clear CS
            //GPIO_writePin(MST_SPI_CS, 0);

            SPI_writeDataNonBlocking(MST_SPI_BASE, MSB_32(VELOCITY_COMMAND));
            SPI_writeDataNonBlocking(MST_SPI_BASE, LSB_32(VELOCITY_COMMAND));
            rData[0]= SPI_readDataBlockingFIFO(MST_SPI_BASE);
            rData[1]= SPI_readDataBlockingFIFO(MST_SPI_BASE);

            HWREG(GPIODATA_BASE + GPIO_O_GPCSET) = 0x100;  //Set CS
            //GPIO_writePin(MST_SPI_CS, 1);
            msg[2]  = FUS_16_TO_32(rData[0], rData[1]);
//            msg[2]=((uint32_t)rData[0] << 16U) |
//                        (uint32_t) rData[1];
            for (i=1;i<6;i++)    /*Minimum High time of SS/ between two transmissions is 350ns(According to the AS5047u datasheet) */
                __mnop();
            HWREG(GPIODATA_BASE + GPIO_O_GPCCLEAR) = 0x100;  //Clear CS
            //GPIO_writePin(MST_SPI_CS, 0);

            SPI_writeDataNonBlocking(MST_SPI_BASE, MSB_32(0x0040001B));
            SPI_writeDataNonBlocking(MST_SPI_BASE, LSB_32(0x0040001B));
            rData[0]= SPI_readDataBlockingFIFO(MST_SPI_BASE);
            rData[1]= SPI_readDataBlockingFIFO(MST_SPI_BASE);

            HWREG(GPIODATA_BASE + GPIO_O_GPCSET) = 0x100;
            //GPIO_writePin(MST_SPI_CS, 1);
            msg[3]  = FUS_16_TO_32(rData[0], rData[1]);
//            msg[3]=((uint32_t)rData[0] << 16U) |
//                        (uint32_t) rData[1];
/**************************CRC PROTECTION************************************/
            for(i=0;i<4;i++){
                com[0]=(msg[i]&0xFFFF0000)>>24;
                com[1]=(msg[i]&0xFFFF0000)>>16;
                uint32_t crc;
                int16_t j,bit;

                crc = 0xC4;
                for ( j=0 ; j<2 ; j++ )
                {
                    crc ^= com[j];
                    for ( bit=0 ; bit<8 ; bit++)
                    {
                        if ( (crc & 0x80)!=0 )
                        {
                            crc <<= 1;
                            crc ^= 0x1D;
                        }
                        else
                        {
                            crc <<= 1;
                        }
                    }
                }
                crc= (crc^0xFF)&0xFF;
                if (((msg[i]&0x0000FF00)>>8)!=crc){crccheck=0;}
            }

            flag=crccheck;

            if(flag)
            {
                angle.all   = msg[0];
                velocity.all= msg[1];
            }
            else
            {
                angle.all   = 0U;
                velocity.all= 0U;
            }
        }
    }
}

