    motor_foc_m1.piIq.integral                          = 0.0f;
    motor_foc_m1.piIq.ff                                = 0.0f;
    motor_foc_m1.piIq.out                               = 0.0f;
    //--- FOC - Initialize PD controller (Speed & position) ---------------------
