__attribute__((interrupt)) void Cla1Task1(void)
{
//    __mdebugstop();
//    DBG_PIN2_SET;
    // Initialize motors structures
    MOT_initStruct(&motor_m1, MOTOR_1);
    MOT_initStruct(&motor_m2, MOTOR_2);
//    DBG_PIN2_CLEAR;
}

