    motor_foc[MOTOR_2].motor_acq.vBusFlt.one_minus_a            = VBUS_LPF_ONE_M_ALPHA;
    motor_foc[MOTOR_2].motor_acq.vExtFlt.a                      = VEXT_LPF_ALPHA;
    motor_foc[MOTOR_2].motor_acq.vExtFlt.one_minus_a            = VEXT_LPF_ONE_M_ALPHA;
    //--- MOTOR ENCORDER STRUCTURE ----------------------------------------------
    motor_foc[MOTOR_2].motor_enc.eqepBaseAddr                   = MOTOR2_QEP_BASE;
    motor_foc[MOTOR_2].motor_enc.polePairs                      = MOTOR2_POLES_PAIRS;
//    motor_foc[MOTOR_2].motor_enc.thetaElec                      = 0.0f;
    motor_foc[MOTOR_2].motor_enc.thetaMech[NEW]                 = 0.0f;
//    motor_foc[MOTOR_2].motor_enc.thetaMech[OLD]                 = 0.0f;
    motor_foc[MOTOR_2].motor_enc.thetaMechScaler                = (float32_t)MOTOR2_ENC_RESOLUTION_SCALE;
