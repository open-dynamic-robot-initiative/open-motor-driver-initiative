    motor_foc[MOTOR_2].motor_enc.speed.speedFlt[0].a            = (float32_t)MOTOR2_ENC_SPEED_LPF_ALPHA;
    motor_foc[MOTOR_2].motor_enc.speed.speedFlt[0].one_minus_a  = (float32_t)MOTOR2_ENC_SPEED_LPF_ONE_M_ALPHA;
    motor_foc[MOTOR_2].motor_enc.speed.speedFlt[1].a            = (float32_t)MOTOR2_ENC_SPEED_LOCAL_LPF_ALPHA;
    motor_foc[MOTOR_2].motor_enc.speed.speedFlt[1].one_minus_a  = (float32_t)MOTOR2_ENC_SPEED_LOCAL_LPF_ONE_M_ALPHA;
    //--- MOTOR COMMAND STRUCTURE -----------------------------------------------
    motor_foc[MOTOR_2].motor_cmd.posRef                         = 0.0f;
    motor_foc[MOTOR_2].motor_cmd.velRef                         = 0.0f;
    motor_foc[MOTOR_2].motor_cmd.iqff                           = 0.0f;
    motor_foc[MOTOR_2].motor_cmd.kpCoeff                        = 0.0f;
    motor_foc[MOTOR_2].motor_cmd.kdCoeff                        = 0.0f;
    motor_foc[MOTOR_2].motor_cmd.iSat                           = MOTOR2_CURRENT_CMD_SAT_MAX;
    motor_foc[MOTOR_2].motor_cmd.timeoutRef                     = 0U;
    motor_foc[MOTOR_2].motor_cmd.cptTimeout                     = 0U;
    motor_foc[MOTOR_2].motor_cmd.index                          = 0U;
    motor_foc[MOTOR_2].motor_cmd.cmdArray.all                   = 0U;
    //--- Initial position for alignment procedure ------------------------------
