    //--- FOC - Park transform results ------------------------------------------
    motor_m2.foc.id                                 = 0.0f;
    motor_m2.foc.iq                                 = 0.0f;
    //--- FOC - Initialize duty cycle saturation --------------------------------
    motor_m2.foc.dtcMax                             = MOTOR2_DTC_MAX;
    motor_m2.foc.dtcMin                             = MOTOR2_DTC_MIN;
    //--- FOC - Initialize PI controller (Id) -----------------------------------
    motor_m2.foc.piId.p_fb.ptr                      = (float32_t *)(&motor_m2.foc.id);
    motor_m2.foc.piId.p_set.ptr                     = (float32_t *)(&motor_m2.foc.idRef);
    motor_m2.foc.piId.p_sat.ptr                     = (float32_t *)(&motor_m2.foc.acq.vbus);
    motor_m2.foc.piId.err                           = 0.0f;
    motor_m2.foc.piId.kp                            = (float32_t)MOTOR2_PI_ID_KP_COEF;
    motor_m2.foc.piId.ki                            = (float32_t)MOTOR2_PI_ID_KI_COEF;
    motor_m2.foc.piId.integral                      = 0.0f;
    motor_m2.foc.piId.ff                            = 0.0f;
    motor_m2.foc.piId.out                           = 0.0f;
    //--- FOC - Initialize PI controller (Iq) -----------------------------------
    motor_m2.foc.piIq.p_fb.ptr                      = (float32_t *)(&motor_m2.foc.iq);
    motor_m2.foc.piIq.p_set.ptr                     = (float32_t *)(&motor_m2.foc.iqRef);
    motor_m2.foc.piIq.p_sat.ptr                     = (float32_t *)(&motor_m2.foc.acq.vbus);
    motor_m2.foc.piIq.err                           = 0.0f;
    motor_m2.foc.piIq.kp                            = (float32_t)MOTOR2_PI_IQ_KP_COEF;
    motor_m2.foc.piIq.ki                            = (float32_t)MOTOR2_PI_IQ_KI_COEF;
    motor_m2.foc.piIq.integral                      = 0.0f;
    motor_m2.foc.piIq.ff                            = 0.0f;
    motor_m2.foc.piIq.out                           = 0.0f;
    //--- FOC - Initialize PD controller (Speed & position) ---------------------
    motor_m2.foc.pdPosVel.p_fbTheta.ptr             = (float32_t *)(&motor_m2.foc.enc.thetaAbsolute);
    motor_m2.foc.pdPosVel.p_setTheta.ptr            = (float32_t *)(&motor_m2.foc.cmd.posRefOffset);
    motor_m2.foc.pdPosVel.errTheta                  = 0.0f;
    motor_m2.foc.pdPosVel.p_fbSpeed.ptr             = (float32_t *)(&motor_m2.foc.enc.speed.speedMech[0]);
    motor_m2.foc.pdPosVel.p_setSpeed.ptr            = (float32_t *)(&motor_m2.foc.cmd.velRef);
    motor_m2.foc.pdPosVel.errSpeed                  = 0.0f;
    motor_m2.foc.pdPosVel.p_kp.ptr                  = (float32_t *)(&motor_m2.foc.cmd.kpCoeff);
    motor_m2.foc.pdPosVel.p_kd.ptr                  = (float32_t *)(&motor_m2.foc.cmd.kdCoeff);
    motor_m2.foc.pdPosVel.derivative                = 0.0f;
    motor_m2.foc.pdPosVel.p_ff.ptr                  = (float32_t *)(&motor_m2.foc.cmd.iqff);
    motor_m2.foc.pdPosVel.p_sat.ptr                 = (float32_t *)(&motor_m2.foc.cmd.iSat);
    motor_m2.foc.pdPosVel.out                       = 0.0f;
    //--- FSM motor initial state -----------------------------------------------
    motor_m2.state                                  = MOTOR_STATE_START;
    //--- Error message ---------------------------------------------------------
    motor_m2.error.all                              = 0;
    //--- DRV IO Config ---------------------------------------------------------
    motor_m2.drvFaultNum                            = MOTOR2_DRV_FAULT_NUM;
    motor_m2.drvEnNum                               = MOTOR2_DRV_EN_NUM;
    //---- PWM config address ---------------------------------------------------
    motor_m2.epwmBase[CHANNEL_1]                    = MOTOR2_PWM1_BASE;
    motor_m2.epwmBase[CHANNEL_2]                    = MOTOR2_PWM2_BASE;
    motor_m2.epwmBase[CHANNEL_3]                    = MOTOR2_PWM3_BASE;
//    DBG_PIN2_CLEAR;
}

