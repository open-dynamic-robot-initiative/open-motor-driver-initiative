__attribute__((interrupt)) void Cla1Task8(void)
{
//    __mdebugstop();
    DBG_PIN2_SET;
    //--- MOTOR PARAMS STRUCTURE ------------------------------------------------
    motor_foc_m1.motor_cfg.Rs                             = MOTOR1_RS;
    motor_foc_m1.motor_cfg.Ls                             = MOTOR1_LS;
    motor_foc_m1.motor_cfg.kv                             = MOTOR1_KV;
    motor_foc_m1.motor_cfg.ke                             = MOTOR1_KE;
    motor_foc_m1.motor_cfg.ki                             = MOTOR1_KI;
    motor_foc_m1.motor_cfg.polePairs                      = MOTOR1_POLES_PAIRS;
    //--- MOTOR ACQUISITION STRUCTURE -------------------------------------------
    motor_foc_m1.motor_acq.p_vExtMeasReg.addr32b          = VEXT1_ADC_PPB_RESULT_ADDR;
    motor_foc_m1.motor_acq.p_vBusMeasReg.addr32b          = VBUS_ADC_PPB_RESULT_ADDR;
    motor_foc_m1.motor_acq.p_iMeasReg[CHANNEL_1].addr32b  = MOTOR1_IA_ADC_PPB_RESULT_ADDR;
    motor_foc_m1.motor_acq.p_iMeasReg[CHANNEL_2].addr32b  = MOTOR1_IB_ADC_PPB_RESULT_ADDR;
    motor_foc_m1.motor_acq.p_iMeasReg[CHANNEL_3].addr32b  = MOTOR1_IC_ADC_PPB_RESULT_ADDR;
    motor_foc_m1.motor_acq.vBusFlt.a                      = VBUS_LPF_ALPHA;
    motor_foc_m1.motor_acq.vBusFlt.one_minus_a            = VBUS_LPF_ONE_M_ALPHA;
    motor_foc_m1.motor_acq.vExtFlt.a                      = VEXT_LPF_ALPHA;
    motor_foc_m1.motor_acq.vExtFlt.one_minus_a            = VEXT_LPF_ONE_M_ALPHA;
    //--- MOTOR ENCORDER STRUCTURE ----------------------------------------------
    motor_foc_m1.motor_enc.eqepBaseAddr                   = MOTOR1_QEP_BASE;
    motor_foc_m1.motor_enc.polePairs                      = MOTOR1_POLES_PAIRS;
    motor_foc_m1.motor_enc.thetaMech[NEW]                 = 0.0f;
    motor_foc_m1.motor_enc.thetaMechScaler                = (float32_t)MOTOR1_ENC_RESOLUTION_SCALE;
    motor_foc_m1.motor_enc.thetaIndexRelative             = 0.0f;
    motor_foc_m1.motor_enc.thetaIndexAbsolute             = 0.0f;
    motor_foc_m1.motor_enc.turnNb                         = 0;
    motor_foc_m1.motor_enc.flags.all                      = 0;
    motor_foc_m1.motor_enc.speed.speedHighScaler          = (float32_t)MOTOR1_ENC_SPEED_HIGH_SCALE;
    motor_foc_m1.motor_enc.speed.speedLowScaler           = (float32_t)MOTOR1_ENC_SPEED_LOW_SCALE;
//    motor_foc_m1.motor_enc.speed.alpha                    = 0.0f;
    motor_foc_m1.motor_enc.speed.speedMech[0]             = 0.0f;
    motor_foc_m1.motor_enc.speed.speedMech[1]             = 0.0f;
    motor_foc_m1.motor_enc.speed.theta[NEW]               = 0.0f;
    motor_foc_m1.motor_enc.speed.speedFlt[0].a            = (float32_t)MOTOR1_ENC_SPEED_LPF_ALPHA;
    motor_foc_m1.motor_enc.speed.speedFlt[0].one_minus_a  = (float32_t)MOTOR1_ENC_SPEED_LPF_ONE_M_ALPHA;
    motor_foc_m1.motor_enc.speed.speedFlt[1].a            = (float32_t)MOTOR1_ENC_SPEED_LOCAL_LPF_ALPHA;
    motor_foc_m1.motor_enc.speed.speedFlt[1].one_minus_a  = (float32_t)MOTOR1_ENC_SPEED_LOCAL_LPF_ONE_M_ALPHA;
    //--- MOTOR COMMAND STRUCTURE -----------------------------------------------
    motor_foc_m1.motor_cmd.posRef                         = 0.0f;
    motor_foc_m1.motor_cmd.posRefOffset                   = 0.0f;
    motor_foc_m1.motor_cmd.velRef                         = 0.0f;
    motor_foc_m1.motor_cmd.iqff                           = 0.0f;
    motor_foc_m1.motor_cmd.kpCoeff                        = 0.0f;
    motor_foc_m1.motor_cmd.kdCoeff                        = 0.0f;
    motor_foc_m1.motor_cmd.iSat                           = MOTOR1_CURRENT_CMD_SAT_MAX;
    motor_foc_m1.motor_cmd.timeoutRef                     = 0U;
    motor_foc_m1.motor_cmd.cptTimeout                     = 0U;
    motor_foc_m1.motor_cmd.index                          = 0U;
    motor_foc_m1.motor_cmd.cmdArray.all                   = 0U;
    //---------------------------------------------------------------------------
    motor_foc_m1.iParkFlt.a                               = MOTOR1_CURRENT_LPF_ALPHA;
    motor_foc_m1.iParkFlt.one_minus_a                     = MOTOR1_CURRENT_LPF_ONE_M_ALPHA;
    //--- FOC - Park transform results ------------------------------------------
    motor_foc_m1.id                                       = 0.0f;
    motor_foc_m1.iq                                       = 0.0f;
    //--- FOC - Initialize duty cycle saturation --------------------------------
    motor_foc_m1.dtcMax                                   = MOTOR1_DTC_MAX;
    motor_foc_m1.dtcMin                                   = MOTOR1_DTC_MIN;
    //--- FOC - Initialize PI controller (Id) -----------------------------------
    motor_foc_m1.piId.p_fb.ptr                            = (float32_t *)(&motor_foc_m1.id);
    motor_foc_m1.piId.p_set.ptr                           = (float32_t *)(&motor_foc_m1.idRef);
    motor_foc_m1.piId.p_sat.ptr                           = (float32_t *)(&motor_foc_m1.motor_acq.vbus);
    motor_foc_m1.piId.err                                 = 0.0f;
    motor_foc_m1.piId.kp                                  = (float32_t)MOTOR1_PI_ID_KP_COEF;
    motor_foc_m1.piId.ki                                  = (float32_t)MOTOR1_PI_ID_KI_COEF;
    motor_foc_m1.piId.integral                            = 0.0f;
    motor_foc_m1.piId.ff                                  = 0.0f;
    motor_foc_m1.piId.out                                 = 0.0f;
    //--- FOC - Initialize PI controller (Iq) -----------------------------------
    motor_foc_m1.piIq.p_fb.ptr                            = (float32_t *)(&motor_foc_m1.iq);
    motor_foc_m1.piIq.p_set.ptr                           = (float32_t *)(&motor_foc_m1.iqRef);
    motor_foc_m1.piIq.p_sat.ptr                           = (float32_t *)(&motor_foc_m1.motor_acq.vbus);
    motor_foc_m1.piIq.err                                 = 0.0f;
    motor_foc_m1.piIq.kp                                  = (float32_t)MOTOR1_PI_IQ_KP_COEF;
    motor_foc_m1.piIq.ki                                  = (float32_t)MOTOR1_PI_IQ_KI_COEF;
    motor_foc_m1.piIq.integral                            = 0.0f;
    motor_foc_m1.piIq.ff                                  = 0.0f;
    motor_foc_m1.piIq.out                                 = 0.0f;
    //--- FOC - Initialize PD controller (Speed & position) ---------------------
    motor_foc_m1.pdPosVel.p_fbTheta.ptr                   = (float32_t *)(&motor_foc_m1.motor_enc.thetaAbsolute);
    motor_foc_m1.pdPosVel.p_setTheta.ptr                  = (float32_t *)(&motor_foc_m1.motor_cmd.posRefOffset);
    motor_foc_m1.pdPosVel.errTheta                        = 0.0f;
    motor_foc_m1.pdPosVel.p_fbSpeed.ptr                   = (float32_t *)(&motor_foc_m1.motor_enc.speed.speedMech[0]);
    motor_foc_m1.pdPosVel.p_setSpeed.ptr                  = (float32_t *)(&motor_foc_m1.motor_cmd.velRef);
    motor_foc_m1.pdPosVel.errSpeed                        = 0.0f;
    motor_foc_m1.pdPosVel.p_kp.ptr                        = (float32_t *)(&motor_foc_m1.motor_cmd.kpCoeff);
    motor_foc_m1.pdPosVel.p_kd.ptr                        = (float32_t *)(&motor_foc_m1.motor_cmd.kdCoeff);
    motor_foc_m1.pdPosVel.derivative                      = 0.0f;
    motor_foc_m1.pdPosVel.p_ff.ptr                        = (float32_t *)(&motor_foc_m1.motor_cmd.iqff);
    motor_foc_m1.pdPosVel.p_sat.ptr                       = (float32_t *)(&motor_foc_m1.motor_cmd.iSat);
    motor_foc_m1.pdPosVel.out                             = 0.0f;
    //---------------------------------------------------------------------------
    //---------------------------------------------------------------------------
    //--- MOTOR PARAMS STRUCTURE ------------------------------------------------
    motor_foc_m2.motor_cfg.Rs                             = MOTOR2_RS;
    motor_foc_m2.motor_cfg.Ls                             = MOTOR2_LS;
    motor_foc_m2.motor_cfg.kv                             = MOTOR2_KV;
    motor_foc_m2.motor_cfg.ke                             = MOTOR2_KE;
    motor_foc_m2.motor_cfg.ki                             = MOTOR2_KI;
    motor_foc_m2.motor_cfg.polePairs                      = MOTOR2_POLES_PAIRS;
    //--- MOTOR ACQUISITION STRUCTURE -------------------------------------------
    motor_foc_m2.motor_acq.p_vExtMeasReg.addr32b          = VEXT2_ADC_PPB_RESULT_ADDR;
    motor_foc_m2.motor_acq.p_vBusMeasReg.addr32b          = VBUS_ADC_PPB_RESULT_ADDR;
    motor_foc_m2.motor_acq.p_iMeasReg[CHANNEL_1].addr32b  = MOTOR2_IA_ADC_PPB_RESULT_ADDR;
    motor_foc_m2.motor_acq.p_iMeasReg[CHANNEL_2].addr32b  = MOTOR2_IB_ADC_PPB_RESULT_ADDR;
    motor_foc_m2.motor_acq.p_iMeasReg[CHANNEL_3].addr32b  = MOTOR2_IC_ADC_PPB_RESULT_ADDR;
    motor_foc_m2.motor_acq.vBusFlt.a                      = VBUS_LPF_ALPHA;
    motor_foc_m2.motor_acq.vBusFlt.one_minus_a            = VBUS_LPF_ONE_M_ALPHA;
    motor_foc_m2.motor_acq.vExtFlt.a                      = VEXT_LPF_ALPHA;
    motor_foc_m2.motor_acq.vExtFlt.one_minus_a            = VEXT_LPF_ONE_M_ALPHA;
    //--- MOTOR ENCORDER STRUCTURE ----------------------------------------------
    motor_foc_m2.motor_enc.eqepBaseAddr                   = MOTOR2_QEP_BASE;
    motor_foc_m2.motor_enc.polePairs                      = MOTOR2_POLES_PAIRS;
    motor_foc_m2.motor_enc.thetaMech[NEW]                 = 0.0f;
    motor_foc_m2.motor_enc.thetaMechScaler                = (float32_t)MOTOR2_ENC_RESOLUTION_SCALE;
    motor_foc_m2.motor_enc.thetaIndexRelative             = 0.0f;
    motor_foc_m2.motor_enc.thetaIndexAbsolute             = 0.0f;
    motor_foc_m2.motor_enc.turnNb                         = 0;
    motor_foc_m2.motor_enc.flags.all                      = 0;
    motor_foc_m2.motor_enc.speed.speedHighScaler          = (float32_t)MOTOR2_ENC_SPEED_HIGH_SCALE;
    motor_foc_m2.motor_enc.speed.speedLowScaler           = (float32_t)MOTOR2_ENC_SPEED_LOW_SCALE;
//    motor_foc_m2.motor_enc.speed.alpha                    = 0.0f;
    motor_foc_m2.motor_enc.speed.speedMech[0]             = 0.0f;
    motor_foc_m2.motor_enc.speed.speedMech[1]             = 0.0f;
    motor_foc_m2.motor_enc.speed.theta[NEW]               = 0.0f;
    motor_foc_m2.motor_enc.speed.speedFlt[0].a            = (float32_t)MOTOR2_ENC_SPEED_LPF_ALPHA;
    motor_foc_m2.motor_enc.speed.speedFlt[0].one_minus_a  = (float32_t)MOTOR2_ENC_SPEED_LPF_ONE_M_ALPHA;
    motor_foc_m2.motor_enc.speed.speedFlt[1].a            = (float32_t)MOTOR2_ENC_SPEED_LOCAL_LPF_ALPHA;
    motor_foc_m2.motor_enc.speed.speedFlt[1].one_minus_a  = (float32_t)MOTOR2_ENC_SPEED_LOCAL_LPF_ONE_M_ALPHA;
    //--- MOTOR COMMAND STRUCTURE -----------------------------------------------
    motor_foc_m2.motor_cmd.posRef                         = 0.0f;
    motor_foc_m2.motor_cmd.posRefOffset                   = 0.0f;
    motor_foc_m2.motor_cmd.velRef                         = 0.0f;
    motor_foc_m2.motor_cmd.iqff                           = 0.0f;
    motor_foc_m2.motor_cmd.kpCoeff                        = 0.0f;
    motor_foc_m2.motor_cmd.kdCoeff                        = 0.0f;
    motor_foc_m2.motor_cmd.iSat                           = MOTOR2_CURRENT_CMD_SAT_MAX;
    motor_foc_m2.motor_cmd.timeoutRef                     = 0U;
    motor_foc_m2.motor_cmd.cptTimeout                     = 0U;
    motor_foc_m2.motor_cmd.index                          = 0U;
    motor_foc_m2.motor_cmd.cmdArray.all                   = 0U;
    //---------------------------------------------------------------------------
    motor_foc_m2.iParkFlt.a                               = MOTOR2_CURRENT_LPF_ALPHA;
    motor_foc_m2.iParkFlt.one_minus_a                     = MOTOR2_CURRENT_LPF_ONE_M_ALPHA;
    //--- FOC - Park transform results ------------------------------------------
    motor_foc_m2.id                                       = 0.0f;
    motor_foc_m2.iq                                       = 0.0f;
    //--- FOC - Initialize duty cycle saturation --------------------------------
    motor_foc_m2.dtcMax                                   = MOTOR2_DTC_MAX;
    motor_foc_m2.dtcMin                                   = MOTOR2_DTC_MIN;
    //--- FOC - Initialize PI controller (Id) -----------------------------------
    motor_foc_m2.piId.p_fb.ptr                            = (float32_t *)(&motor_foc_m2.id);
    motor_foc_m2.piId.p_set.ptr                           = (float32_t *)(&motor_foc_m2.idRef);
    motor_foc_m2.piId.p_sat.ptr                           = (float32_t *)(&motor_foc_m2.motor_acq.vbus);
    motor_foc_m2.piId.err                                 = 0.0f;
    motor_foc_m2.piId.kp                                  = (float32_t)MOTOR2_PI_ID_KP_COEF;
    motor_foc_m2.piId.ki                                  = (float32_t)MOTOR2_PI_ID_KI_COEF;
    motor_foc_m2.piId.integral                            = 0.0f;
    motor_foc_m2.piId.ff                                  = 0.0f;
    motor_foc_m2.piId.out                                 = 0.0f;
    //--- FOC - Initialize PI controller (Iq) -----------------------------------
    motor_foc_m2.piIq.p_fb.ptr                            = (float32_t *)(&motor_foc_m2.iq);
    motor_foc_m2.piIq.p_set.ptr                           = (float32_t *)(&motor_foc_m2.iqRef);
    motor_foc_m2.piIq.p_sat.ptr                           = (float32_t *)(&motor_foc_m2.motor_acq.vbus);
    motor_foc_m2.piIq.err                                 = 0.0f;
    motor_foc_m2.piIq.kp                                  = (float32_t)MOTOR2_PI_IQ_KP_COEF;
    motor_foc_m2.piIq.ki                                  = (float32_t)MOTOR2_PI_IQ_KI_COEF;
    motor_foc_m2.piIq.integral                            = 0.0f;
    motor_foc_m2.piIq.ff                                  = 0.0f;
    motor_foc_m2.piIq.out                                 = 0.0f;
    //--- FOC - Initialize PD controller (Speed & position) ---------------------
    motor_foc_m2.pdPosVel.p_fbTheta.ptr                   = (float32_t *)(&motor_foc_m2.motor_enc.thetaAbsolute);
    motor_foc_m2.pdPosVel.p_setTheta.ptr                  = (float32_t *)(&motor_foc_m2.motor_cmd.posRefOffset);
    motor_foc_m2.pdPosVel.errTheta                        = 0.0f;
    motor_foc_m2.pdPosVel.p_fbSpeed.ptr                   = (float32_t *)(&motor_foc_m2.motor_enc.speed.speedMech[0]);
    motor_foc_m2.pdPosVel.p_setSpeed.ptr                  = (float32_t *)(&motor_foc_m2.motor_cmd.velRef);
    motor_foc_m2.pdPosVel.errSpeed                        = 0.0f;
    motor_foc_m2.pdPosVel.p_kp.ptr                        = (float32_t *)(&motor_foc_m2.motor_cmd.kpCoeff);
    motor_foc_m2.pdPosVel.p_kd.ptr                        = (float32_t *)(&motor_foc_m2.motor_cmd.kdCoeff);
    motor_foc_m2.pdPosVel.derivative                      = 0.0f;
    motor_foc_m2.pdPosVel.p_ff.ptr                        = (float32_t *)(&motor_foc_m2.motor_cmd.iqff);
    motor_foc_m2.pdPosVel.p_sat.ptr                       = (float32_t *)(&motor_foc_m2.motor_cmd.iSat);
    motor_foc_m2.pdPosVel.out                             = 0.0f;

    //--- MOTOR_1 ---------------------------------------------------------------
    motor_m1.motor_id                                     = MOTOR_1;
    //--- FOC structure address -------------------------------------------------
    motor_m1.p_foc.ptr                                    = &motor_foc_m1;
    //--- FSM motor initial state -----------------------------------------------
    motor_m1.motor_state                                  = MOTOR_STATE_START;
    //--- Error message ---------------------------------------------------------
    motor_m1.motor_error.all                              = 0;
    //---------------------------------------------------------------------------
    motor_m1.itDone                                       = false;
    //--- DRV IO Config ---------------------------------------------------------
    motor_m1.drvFaultNum                                  = MOTOR1_DRV_FAULT_NUM;
    motor_m1.drvEnNum                                     = MOTOR1_DRV_EN_NUM;
    //---- PWM config address ---------------------------------------------------
    motor_m1.epwmBaseAddr[CHANNEL_1]                      = MOTOR1_PWM1_BASE;
    motor_m1.epwmBaseAddr[CHANNEL_2]                      = MOTOR1_PWM2_BASE;
    motor_m1.epwmBaseAddr[CHANNEL_3]                      = MOTOR1_PWM3_BASE;
    //---- PWM command address --------------------------------------------------
    motor_m1.p_cmdReg[CHANNEL_1].addr32b                  = MOTOR1_PWM1_CMD_ADDR;
    motor_m1.p_cmdReg[CHANNEL_2].addr32b                  = MOTOR1_PWM2_CMD_ADDR;
    motor_m1.p_cmdReg[CHANNEL_3].addr32b                  = MOTOR1_PWM3_CMD_ADDR;

    //--- MOTOR_2 ---------------------------------------------------------------
    motor_m2.motor_id                                     = MOTOR_2;
    //--- FOC structure address -------------------------------------------------
    motor_m2.p_foc.ptr                                    = &motor_foc_m2;
    //--- FSM motor initial state -----------------------------------------------
    motor_m2.motor_state                                  = MOTOR_STATE_START;
    //--- Error message ---------------------------------------------------------
    motor_m2.motor_error.all                              = 0;
    //---------------------------------------------------------------------------
    motor_m2.itDone                                       = false;
    //--- DRV IO Config ---------------------------------------------------------
    motor_m2.drvFaultNum                                  = MOTOR2_DRV_FAULT_NUM;
    motor_m2.drvEnNum                                     = MOTOR2_DRV_EN_NUM;
    //---- PWM config address ---------------------------------------------------
    motor_m2.epwmBaseAddr[CHANNEL_1]                      = MOTOR2_PWM1_BASE;
    motor_m2.epwmBaseAddr[CHANNEL_2]                      = MOTOR2_PWM2_BASE;
    motor_m2.epwmBaseAddr[CHANNEL_3]                      = MOTOR2_PWM3_BASE;
    //---- PWM command address --------------------------------------------------
    motor_m2.p_cmdReg[CHANNEL_1].addr32b                  = MOTOR2_PWM1_CMD_ADDR;
    motor_m2.p_cmdReg[CHANNEL_2].addr32b                  = MOTOR2_PWM2_CMD_ADDR;
    motor_m2.p_cmdReg[CHANNEL_3].addr32b                  = MOTOR2_PWM3_CMD_ADDR;
}

