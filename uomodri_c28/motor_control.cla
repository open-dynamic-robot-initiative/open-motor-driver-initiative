/***********************************************************************
* INCLUDES
***********************************************************************/
#include "uomodri_user_defines.h"
#if (!CLA1_TEST_CORE_ENABLE) && (CLA_CORE_ENABLE)
#include "CLAmath.h"
#include "uOmodri_shared.h"
#endif
#include "f2838x_device.h"
#include "driverlib.h"

/***********************************************************************
 * VARIABLES
 ***********************************************************************/
#if (CLA_CORE_ENABLE)
extern foc_t    motor_foc_m1;
extern foc_t    motor_foc_m2;
extern motor_t  motor_m1;
extern motor_t  motor_m2;
extern cmd_t    cmd_uOmodri[];
//extern bool_t ch_extract;
#elif (CLA1_TEST_CORE_ENABLE)
uint16_t i;
#endif

/***********************************************************************
 * DEFINES
 ***********************************************************************/
#define MAX_LOOP    (10)

/***********************************************************************
 * FUNCTIONS DECLARATION
 ***********************************************************************/

/***********************************************************************
 * FUNCTIONS DEFINITION
 ***********************************************************************/
#if (CLA_CORE_ENABLE)
__attribute__((interrupt)) void Cla1Task1(void)
{
    DBG_PIN1_SET;
//    __mdebugstop();
    // Motor control
    motor_m1.itDone = MOT_runControl(&motor_m1);
    DBG_PIN1_CLEAR;
}

__attribute__((interrupt)) void Cla1Task2(void)
{
    DBG_PIN2_SET;
//    __mdebugstop();
    // Motor control
    motor_m2.itDone = MOT_runControl(&motor_m2);
    DBG_PIN2_CLEAR;
}

__attribute__((interrupt)) void Cla1Task3(void)
{
#if (0)
    if((cmd_uOmodri[MOTOR_1].cmdArray.all & 0x0B) == 0x0B)
        cmd_uOmodri[MOTOR_1].posRef += ((foc_t *)(motor_m1.p_foc.ptr))->motor_enc.thetaIndexAbsolute;
    if((cmd_uOmodri[MOTOR_2].cmdArray.all & 0x0B) == 0x0B)
        cmd_uOmodri[MOTOR_2].posRef += ((foc_t *)(motor_m2.p_foc.ptr))->motor_enc.thetaIndexAbsolute;

    ((foc_t *)(motor_m1.p_foc.ptr))->motor_cmd = cmd_uOmodri[MOTOR_1];
    ((foc_t *)(motor_m2.p_foc.ptr))->motor_cmd = cmd_uOmodri[MOTOR_2];
#else
//    __mdebugstop();
    if((cmd_uOmodri[MOTOR_1].cmdArray.all & 0x0B) == 0x0B)
        cmd_uOmodri[MOTOR_1].posRef += ((foc_t *)(motor_m1.p_foc.ptr))->motor_enc.thetaIndexAbsolute;
    ((foc_t *)(motor_m1.p_foc.ptr))->motor_cmd.posRef     = cmd_uOmodri[MOTOR_1].posRef;
    ((foc_t *)(motor_m1.p_foc.ptr))->motor_cmd.velRef     = cmd_uOmodri[MOTOR_1].velRef;
    ((foc_t *)(motor_m1.p_foc.ptr))->motor_cmd.iqff       = cmd_uOmodri[MOTOR_1].iqff;
    ((foc_t *)(motor_m1.p_foc.ptr))->motor_cmd.kpCoeff    = cmd_uOmodri[MOTOR_1].kpCoeff;
    ((foc_t *)(motor_m1.p_foc.ptr))->motor_cmd.kdCoeff    = cmd_uOmodri[MOTOR_1].kdCoeff;
    ((foc_t *)(motor_m1.p_foc.ptr))->motor_cmd.iSat       = cmd_uOmodri[MOTOR_1].iSat;
    ((foc_t *)(motor_m1.p_foc.ptr))->motor_cmd.timeoutRef = cmd_uOmodri[MOTOR_1].timeoutRef;
    ((foc_t *)(motor_m1.p_foc.ptr))->motor_cmd.cptTimeout = cmd_uOmodri[MOTOR_1].cptTimeout;
    ((foc_t *)(motor_m1.p_foc.ptr))->motor_cmd.index      = cmd_uOmodri[MOTOR_1].index;
    ((foc_t *)(motor_m1.p_foc.ptr))->motor_cmd.cmdArray   = cmd_uOmodri[MOTOR_1].cmdArray;

    if((cmd_uOmodri[MOTOR_2].cmdArray.all & 0x0B) == 0x0B)
        cmd_uOmodri[MOTOR_2].posRef += ((foc_t *)(motor_m2.p_foc.ptr))->motor_enc.thetaIndexAbsolute;
    ((foc_t *)(motor_m2.p_foc.ptr))->motor_cmd.posRef     = cmd_uOmodri[MOTOR_2].posRef;
    ((foc_t *)(motor_m2.p_foc.ptr))->motor_cmd.velRef     = cmd_uOmodri[MOTOR_2].velRef;
    ((foc_t *)(motor_m2.p_foc.ptr))->motor_cmd.iqff       = cmd_uOmodri[MOTOR_2].iqff;
    ((foc_t *)(motor_m2.p_foc.ptr))->motor_cmd.kpCoeff    = cmd_uOmodri[MOTOR_2].kpCoeff;
    ((foc_t *)(motor_m2.p_foc.ptr))->motor_cmd.kdCoeff    = cmd_uOmodri[MOTOR_2].kdCoeff;
    ((foc_t *)(motor_m2.p_foc.ptr))->motor_cmd.iSat       = cmd_uOmodri[MOTOR_2].iSat;
    ((foc_t *)(motor_m2.p_foc.ptr))->motor_cmd.timeoutRef = cmd_uOmodri[MOTOR_2].timeoutRef;
    ((foc_t *)(motor_m2.p_foc.ptr))->motor_cmd.cptTimeout = cmd_uOmodri[MOTOR_2].cptTimeout;
    ((foc_t *)(motor_m2.p_foc.ptr))->motor_cmd.index      = cmd_uOmodri[MOTOR_2].index;
    ((foc_t *)(motor_m2.p_foc.ptr))->motor_cmd.cmdArray   = cmd_uOmodri[MOTOR_2].cmdArray;
#endif
}

