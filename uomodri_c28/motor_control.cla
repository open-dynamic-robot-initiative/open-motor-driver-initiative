__interrupt void Cla1Task8 ( void )
{
    // Uncomment this to debug the CLA while connected to the debugger
    __mdebugstop();

    //--- MOTOR PARAMS STRUCTURE ------------------------------------------------
    motor_foc[MOTOR_1].motor_cfg.Rs                             = MOTOR1_RS;
    motor_foc[MOTOR_1].motor_cfg.Ls                             = MOTOR1_LS;
    motor_foc[MOTOR_1].motor_cfg.kv                             = MOTOR1_KV;
    motor_foc[MOTOR_1].motor_cfg.ke                             = MOTOR1_KE;
    motor_foc[MOTOR_1].motor_cfg.ki                             = MOTOR1_KI;
    motor_foc[MOTOR_1].motor_cfg.polePairs                      = MOTOR1_POLES_PAIRS;
    //--- MOTOR ACQUISITION STRUCTURE -------------------------------------------
    motor_foc[MOTOR_1].motor_acq.p_vExtMeasReg.addr32b          = VEXT1_ADC_PPB_RESULT_ADDR;
    motor_foc[MOTOR_1].motor_acq.p_vBusMeasReg.addr32b          = VBUS_ADC_PPB_RESULT_ADDR;
    motor_foc[MOTOR_1].motor_acq.p_iMeasReg[CHANNEL_1].addr32b  = MOTOR1_IA_ADC_PPB_RESULT_ADDR;
    motor_foc[MOTOR_1].motor_acq.p_iMeasReg[CHANNEL_2].addr32b  = MOTOR1_IB_ADC_PPB_RESULT_ADDR;
    motor_foc[MOTOR_1].motor_acq.p_iMeasReg[CHANNEL_3].addr32b  = MOTOR1_IC_ADC_PPB_RESULT_ADDR;
    motor_foc[MOTOR_1].motor_acq.vbus                           = 0.0f;
    motor_foc[MOTOR_1].motor_acq.vExt                           = 0.0f;
    motor_foc[MOTOR_1].motor_acq.ia                             = 0.0f;
    motor_foc[MOTOR_1].motor_acq.ib                             = 0.0f;
    motor_foc[MOTOR_1].motor_acq.ic                             = 0.0f;
    motor_foc[MOTOR_1].motor_acq.vBusFlt.a                      = VBUS_LPF_ALPHA;
    motor_foc[MOTOR_1].motor_acq.vBusFlt.one_minus_a            = VBUS_LPF_ONE_M_ALPHA;
    motor_foc[MOTOR_1].motor_acq.vExtFlt.a                      = VEXT_LPF_ALPHA;
    motor_foc[MOTOR_1].motor_acq.vExtFlt.one_minus_a            = VEXT_LPF_ONE_M_ALPHA;
    //--- MOTOR ENCORDER STRUCTURE ----------------------------------------------
    motor_foc[MOTOR_1].motor_enc.eqepBaseAddr                   = MOTOR1_QEP_BASE;
    motor_foc[MOTOR_1].motor_enc.polePairs                      = MOTOR1_POLES_PAIRS;
    motor_foc[MOTOR_1].motor_enc.thetaElec                      = 0.0f;
    motor_foc[MOTOR_1].motor_enc.thetaMech[NEW]                 = 0.0f;
    motor_foc[MOTOR_1].motor_enc.thetaMech[OLD]                 = 0.0f;
    motor_foc[MOTOR_1].motor_enc.thetaMechScaler                = (float32_t)MOTOR1_ENC_RESOLUTION_SCALE;
    motor_foc[MOTOR_1].motor_enc.thetaIndex                     = 0.0f;
    motor_foc[MOTOR_1].motor_enc.thetaAbsolute                  = 0.0f;
    motor_foc[MOTOR_1].motor_enc.turnNb                         = 0;
    motor_foc[MOTOR_1].motor_enc.thetaDir                       = 0;
    motor_foc[MOTOR_1].motor_enc.indexDetect                    = false;
    motor_foc[MOTOR_1].motor_enc.indexOffset                    = false;
    motor_foc[MOTOR_1].motor_enc.indexToggle                    = false;
    motor_foc[MOTOR_1].motor_enc.indexError                     = false;
    motor_foc[MOTOR_1].motor_enc.rollOverError                  = false;
    motor_foc[MOTOR_1].motor_enc.speed.speedHighScaler          = (float32_t)MOTOR1_ENC_SPEED_HIGH_SCALE;
    motor_foc[MOTOR_1].motor_enc.speed.speedHigh                = 0.0f;
    motor_foc[MOTOR_1].motor_enc.speed.speedLowScaler           = (float32_t)MOTOR1_ENC_SPEED_LOW_SCALE;
    motor_foc[MOTOR_1].motor_enc.speed.speedLow                 = 0.0f;
    motor_foc[MOTOR_1].motor_enc.speed.alpha                    = 0.0f;
    motor_foc[MOTOR_1].motor_enc.speed.speedMech[0]             = 0.0f;
    motor_foc[MOTOR_1].motor_enc.speed.speedMech[1]             = 0.0f;
    motor_foc[MOTOR_1].motor_enc.speed.speedElec                = 0.0f;
    motor_foc[MOTOR_1].motor_enc.speed.theta[NEW]               = 0.0f;
    motor_foc[MOTOR_1].motor_enc.speed.theta[OLD]               = 0.0f;
    motor_foc[MOTOR_1].motor_enc.speed.speedFlt[0].a            = (float32_t)MOTOR1_ENC_SPEED_LPF_ALPHA;
    motor_foc[MOTOR_1].motor_enc.speed.speedFlt[0].one_minus_a  = (float32_t)MOTOR1_ENC_SPEED_LPF_ONE_M_ALPHA;
    motor_foc[MOTOR_1].motor_enc.speed.speedFlt[1].a            = (float32_t)MOTOR1_ENC_SPEED_LOCAL_LPF_ALPHA;
    motor_foc[MOTOR_1].motor_enc.speed.speedFlt[1].one_minus_a  = (float32_t)MOTOR1_ENC_SPEED_LOCAL_LPF_ONE_M_ALPHA;
    //--- MOTOR COMMAND STRUCTURE -----------------------------------------------
    motor_foc[MOTOR_1].motor_cmd.posRef                         = 0.0f;
    motor_foc[MOTOR_1].motor_cmd.velRef                         = 0.0f;
    motor_foc[MOTOR_1].motor_cmd.iqff                           = 0.0f;
    motor_foc[MOTOR_1].motor_cmd.kpCoeff                        = 0.0f;
    motor_foc[MOTOR_1].motor_cmd.kdCoeff                        = 0.0f;
    motor_foc[MOTOR_1].motor_cmd.iSat                           = MOTOR1_CURRENT_CMD_SAT_MAX;
    motor_foc[MOTOR_1].motor_cmd.timeoutRef                     = 0U;
    motor_foc[MOTOR_1].motor_cmd.cptTimeout                     = 0U;
    motor_foc[MOTOR_1].motor_cmd.index                          = 0U;
    motor_foc[MOTOR_1].motor_cmd.cmdArray.all                   = 0U;
    //--- Initial position for alignment procedure ------------------------------
    motor_foc[MOTOR_1].posAlign                                 = MOTOR1_POSITION_ALIGN_MAX,
    //---------------------------------------------------------------------------
    motor_foc[MOTOR_1].iParkFlt.a                               = MOTOR1_CURRENT_LPF_ALPHA;
    motor_foc[MOTOR_1].iParkFlt.one_minus_a                     = MOTOR1_CURRENT_LPF_ONE_M_ALPHA;
    //--- FOC - Sine / Cosine computation of angular position -------------------
    motor_foc[MOTOR_1].sinTheta                                 = 0.0f;
    motor_foc[MOTOR_1].cosTheta                                 = 0.0f;
    //--- FOC - Clarke transform results ----------------------------------------
    motor_foc[MOTOR_1].ialpha                                   = 0.0f;
    motor_foc[MOTOR_1].ibeta                                    = 0.0f;
    //--- FOC - Park transform results ------------------------------------------
    motor_foc[MOTOR_1].id                                       = 0.0f;
    motor_foc[MOTOR_1].iq                                       = 0.0f;
    //--- FOC - Inverse Park transform results ----------------------------------
    motor_foc[MOTOR_1].ud                                       = 0.0f;
    motor_foc[MOTOR_1].uq                                       = 0.0f;
    //--- FOC - Inverse Clarke transform results --------------------------------
    motor_foc[MOTOR_1].ualpha                                   = 0.0f;
    motor_foc[MOTOR_1].ubeta                                    = 0.0f;
    //--- FOC - Phase commands --------------------------------------------------
    motor_foc[MOTOR_1].ua                                       = 0.0f;
    motor_foc[MOTOR_1].ub                                       = 0.0f;
    motor_foc[MOTOR_1].uc                                       = 0.0f;
    //--- FOC - Max current and voltage -----------------------------------------
    motor_foc[MOTOR_1].vmax                                     = 0.0f;
    //  .imax                                 = MOTOR12_IMAX;
    //--- FOC - Initialize duty cycle saturation --------------------------------
    motor_foc[MOTOR_1].dtcMax                                   = MOTOR1_DTC_MAX;
    motor_foc[MOTOR_1].dtcMin                                   = MOTOR1_DTC_MIN;
    //--- FOC - Duty cycles -----------------------------------------------------
    motor_foc[MOTOR_1].dtc_u                                    = 0.0f;
    motor_foc[MOTOR_1].dtc_v                                    = 0.0f;
    motor_foc[MOTOR_1].dtc_w                                    = 0.0f;
    //--- FOC - PI setpoint values ----------------------------------------------
    motor_foc[MOTOR_1].idRef                                    = 0.0f;
    motor_foc[MOTOR_1].iqRef                                    = 0.0f;
    //--- FOC - Initialize PI controller (Id) -----------------------------------
    motor_foc[MOTOR_1].piId.p_fb.ptr                            = (float32_t *)(&motor_foc[MOTOR_1].id);
    motor_foc[MOTOR_1].piId.p_set.ptr                           = (float32_t *)(&motor_foc[MOTOR_1].idRef);
    motor_foc[MOTOR_1].piId.p_sat.ptr                           = (float32_t *)(&motor_foc[MOTOR_1].motor_acq.vbus);
    motor_foc[MOTOR_1].piId.err                                 = 0.0f;
    motor_foc[MOTOR_1].piId.kp                                  = (float32_t)MOTOR1_PI_ID_KP_COEF;
    motor_foc[MOTOR_1].piId.ki                                  = (float32_t)MOTOR1_PI_ID_KI_COEF;
    motor_foc[MOTOR_1].piId.integral                            = 0.0f;
    motor_foc[MOTOR_1].piId.ff                                  = 0.0f;
    motor_foc[MOTOR_1].piId.out                                 = 0.0f;
    //--- FOC - Initialize PI controller (Iq) -----------------------------------
    motor_foc[MOTOR_1].piIq.p_fb.ptr                            = (float32_t *)(&motor_foc[MOTOR_1].iq);
    motor_foc[MOTOR_1].piIq.p_set.ptr                           = (float32_t *)(&motor_foc[MOTOR_1].iqRef);
    motor_foc[MOTOR_1].piIq.p_sat.ptr                           = (float32_t *)(&motor_foc[MOTOR_1].motor_acq.vbus);
    motor_foc[MOTOR_1].piIq.err                                 = 0.0f;
    motor_foc[MOTOR_1].piIq.kp                                  = (float32_t)MOTOR1_PI_IQ_KP_COEF;
    motor_foc[MOTOR_1].piIq.ki                                  = (float32_t)MOTOR1_PI_IQ_KI_COEF;
    motor_foc[MOTOR_1].piIq.integral                            = 0.0f;
    motor_foc[MOTOR_1].piIq.ff                                  = 0.0f;
    motor_foc[MOTOR_1].piIq.out                                 = 0.0f;
    //--- FOC - Initialize PD controller (Speed & position) ---------------------
    motor_foc[MOTOR_1].pdPosVel.p_fbTheta.ptr                   = (float32_t *)(&motor_foc[MOTOR_1].motor_enc.thetaAbsolute);
    motor_foc[MOTOR_1].pdPosVel.p_setTheta.ptr                  = (float32_t *)(&motor_foc[MOTOR_1].motor_cmd.posRef);
    motor_foc[MOTOR_1].pdPosVel.errTheta                        = 0.0f;
    motor_foc[MOTOR_1].pdPosVel.p_fbSpeed.ptr                   = (float32_t *)(&motor_foc[MOTOR_1].motor_enc.speed.speedMech[0]);
    motor_foc[MOTOR_1].pdPosVel.p_setSpeed.ptr                  = (float32_t *)(&motor_foc[MOTOR_1].motor_cmd.velRef);
    motor_foc[MOTOR_1].pdPosVel.errSpeed                        = 0.0f;
    motor_foc[MOTOR_1].pdPosVel.p_kp.ptr                        = (float32_t *)(&motor_foc[MOTOR_1].motor_cmd.kpCoeff);
    motor_foc[MOTOR_1].pdPosVel.p_kd.ptr                        = (float32_t *)(&motor_foc[MOTOR_1].motor_cmd.kdCoeff);
    motor_foc[MOTOR_1].pdPosVel.derivative                      = 0.0f;
    motor_foc[MOTOR_1].pdPosVel.p_ff.ptr                        = (float32_t *)(&motor_foc[MOTOR_1].motor_cmd.iqff);
    motor_foc[MOTOR_1].pdPosVel.p_sat.ptr                       = (float32_t *)(&motor_foc[MOTOR_1].motor_cmd.iSat);
    //--- FOC - Q-axis resistance estimation ------------------------------------
    motor_foc[MOTOR_1].resEst                                   = 1.0f;
    //--- Resistance estimation low-pass filter ---------------------------------
    motor_foc[MOTOR_1].resEstFlt.a                              = MOTOR1_STATOR_RESISTOR_LPF_ALPHA;
    motor_foc[MOTOR_1].resEstFlt.one_minus_a                    = MOTOR1_STATOR_RESISTOR_LPF_ONE_M_ALPHA;
     //---------------------------------------------------------------------------
     //---------------------------------------------------------------------------
    //--- MOTOR PARAMS STRUCTURE ------------------------------------------------
    motor_foc[MOTOR_2].motor_cfg.Rs                             = MOTOR2_RS;
    motor_foc[MOTOR_2].motor_cfg.Ls                             = MOTOR2_LS;
    motor_foc[MOTOR_2].motor_cfg.kv                             = MOTOR2_KV;
    motor_foc[MOTOR_2].motor_cfg.ke                             = MOTOR2_KE;
    motor_foc[MOTOR_2].motor_cfg.ki                             = MOTOR2_KI;
    motor_foc[MOTOR_2].motor_cfg.polePairs                      = MOTOR2_POLES_PAIRS;
    //--- MOTOR ACQUISITION STRUCTURE -------------------------------------------
    motor_foc[MOTOR_2].motor_acq.p_vExtMeasReg.addr32b          = VEXT2_ADC_PPB_RESULT_ADDR;
    motor_foc[MOTOR_2].motor_acq.p_vBusMeasReg.addr32b          = VBUS_ADC_PPB_RESULT_ADDR;
    motor_foc[MOTOR_2].motor_acq.p_iMeasReg[CHANNEL_1].addr32b  = MOTOR2_IA_ADC_PPB_RESULT_ADDR;
    motor_foc[MOTOR_2].motor_acq.p_iMeasReg[CHANNEL_2].addr32b  = MOTOR2_IB_ADC_PPB_RESULT_ADDR;
    motor_foc[MOTOR_2].motor_acq.p_iMeasReg[CHANNEL_3].addr32b  = MOTOR2_IC_ADC_PPB_RESULT_ADDR;
    motor_foc[MOTOR_2].motor_acq.vbus                           = 0.0f;
    motor_foc[MOTOR_2].motor_acq.vExt                           = 0.0f;
    motor_foc[MOTOR_2].motor_acq.ia                             = 0.0f;
    motor_foc[MOTOR_2].motor_acq.ib                             = 0.0f;
    motor_foc[MOTOR_2].motor_acq.ic                             = 0.0f;
    motor_foc[MOTOR_2].motor_acq.vBusFlt.a                      = VBUS_LPF_ALPHA;
    motor_foc[MOTOR_2].motor_acq.vBusFlt.one_minus_a            = VBUS_LPF_ONE_M_ALPHA;
    motor_foc[MOTOR_2].motor_acq.vExtFlt.a                      = VEXT_LPF_ALPHA;
    motor_foc[MOTOR_2].motor_acq.vExtFlt.one_minus_a            = VEXT_LPF_ONE_M_ALPHA;
    //--- MOTOR ENCORDER STRUCTURE ----------------------------------------------
    motor_foc[MOTOR_2].motor_enc.eqepBaseAddr                   = MOTOR2_QEP_BASE;
    motor_foc[MOTOR_2].motor_enc.polePairs                      = MOTOR2_POLES_PAIRS;
    motor_foc[MOTOR_2].motor_enc.thetaElec                      = 0.0f;
    motor_foc[MOTOR_2].motor_enc.thetaMech[NEW]                 = 0.0f;
    motor_foc[MOTOR_2].motor_enc.thetaMech[OLD]                 = 0.0f;
    motor_foc[MOTOR_2].motor_enc.thetaMechScaler                = (float32_t)MOTOR2_ENC_RESOLUTION_SCALE;
    motor_foc[MOTOR_2].motor_enc.thetaIndex                     = 0.0f;
    motor_foc[MOTOR_2].motor_enc.thetaAbsolute                  = 0.0f;
    motor_foc[MOTOR_2].motor_enc.turnNb                         = 0;
    motor_foc[MOTOR_2].motor_enc.thetaDir                       = 0;
    motor_foc[MOTOR_2].motor_enc.indexDetect                    = false;
    motor_foc[MOTOR_2].motor_enc.indexOffset                    = false;
    motor_foc[MOTOR_2].motor_enc.indexToggle                    = false;
    motor_foc[MOTOR_2].motor_enc.indexError                     = false;
    motor_foc[MOTOR_2].motor_enc.rollOverError                  = false;
    motor_foc[MOTOR_2].motor_enc.speed.speedHighScaler          = (float32_t)MOTOR2_ENC_SPEED_HIGH_SCALE;
    motor_foc[MOTOR_2].motor_enc.speed.speedHigh                = 0.0f;
    motor_foc[MOTOR_2].motor_enc.speed.speedLowScaler           = (float32_t)MOTOR2_ENC_SPEED_LOW_SCALE;
    motor_foc[MOTOR_2].motor_enc.speed.speedLow                 = 0.0f;
    motor_foc[MOTOR_2].motor_enc.speed.alpha                    = 0.0f;
    motor_foc[MOTOR_2].motor_enc.speed.speedMech[0]             = 0.0f;
    motor_foc[MOTOR_2].motor_enc.speed.speedMech[1]             = 0.0f;
    motor_foc[MOTOR_2].motor_enc.speed.speedElec                = 0.0f;
    motor_foc[MOTOR_2].motor_enc.speed.theta[NEW]               = 0.0f;
    motor_foc[MOTOR_2].motor_enc.speed.theta[OLD]               = 0.0f;
    motor_foc[MOTOR_2].motor_enc.speed.speedFlt[0].a            = (float32_t)MOTOR2_ENC_SPEED_LPF_ALPHA;
    motor_foc[MOTOR_2].motor_enc.speed.speedFlt[0].one_minus_a  = (float32_t)MOTOR2_ENC_SPEED_LPF_ONE_M_ALPHA;
    motor_foc[MOTOR_2].motor_enc.speed.speedFlt[1].a            = (float32_t)MOTOR2_ENC_SPEED_LOCAL_LPF_ALPHA;
    motor_foc[MOTOR_2].motor_enc.speed.speedFlt[1].one_minus_a  = (float32_t)MOTOR2_ENC_SPEED_LOCAL_LPF_ONE_M_ALPHA;
    //--- MOTOR COMMAND STRUCTURE -----------------------------------------------
    motor_foc[MOTOR_2].motor_cmd.posRef                         = 0.0f;
    motor_foc[MOTOR_2].motor_cmd.velRef                         = 0.0f;
    motor_foc[MOTOR_2].motor_cmd.iqff                           = 0.0f;
    motor_foc[MOTOR_2].motor_cmd.kpCoeff                        = 0.0f;
    motor_foc[MOTOR_2].motor_cmd.kdCoeff                        = 0.0f;
    motor_foc[MOTOR_2].motor_cmd.iSat                           = MOTOR2_CURRENT_CMD_SAT_MAX;
    motor_foc[MOTOR_2].motor_cmd.timeoutRef                     = 0U;
    motor_foc[MOTOR_2].motor_cmd.cptTimeout                     = 0U;
    motor_foc[MOTOR_2].motor_cmd.index                          = 0U;
    motor_foc[MOTOR_2].motor_cmd.cmdArray.all                   = 0U;
    //--- Initial position for alignment procedure ------------------------------
    motor_foc[MOTOR_2].posAlign                                 = MOTOR2_POSITION_ALIGN_MAX,
    //---------------------------------------------------------------------------
    motor_foc[MOTOR_2].iParkFlt.a                               = MOTOR2_CURRENT_LPF_ALPHA;
    motor_foc[MOTOR_2].iParkFlt.one_minus_a                     = MOTOR2_CURRENT_LPF_ONE_M_ALPHA;
    //--- FOC - Sine / Cosine computation of angular position -------------------
    motor_foc[MOTOR_2].sinTheta                                 = 0.0f;
    motor_foc[MOTOR_2].cosTheta                                 = 0.0f;
    //--- FOC - Clarke transform results ----------------------------------------
    motor_foc[MOTOR_2].ialpha                                   = 0.0f;
    motor_foc[MOTOR_2].ibeta                                    = 0.0f;
    //--- FOC - Park transform results ------------------------------------------
    motor_foc[MOTOR_2].id                                       = 0.0f;
    motor_foc[MOTOR_2].iq                                       = 0.0f;
    //--- FOC - Inverse Park transform results ----------------------------------
    motor_foc[MOTOR_2].ud                                       = 0.0f;
    motor_foc[MOTOR_2].uq                                       = 0.0f;
    //--- FOC - Inverse Clarke transform results --------------------------------
    motor_foc[MOTOR_2].ualpha                                   = 0.0f;
    motor_foc[MOTOR_2].ubeta                                    = 0.0f;
    //--- FOC - Phase commands --------------------------------------------------
    motor_foc[MOTOR_2].ua                                       = 0.0f;
    motor_foc[MOTOR_2].ub                                       = 0.0f;
    motor_foc[MOTOR_2].uc                                       = 0.0f;
    //--- FOC - Max current and voltage -----------------------------------------
    motor_foc[MOTOR_2].vmax                                     = 0.0f;
    //--- FOC - Initialize duty cycle saturation --------------------------------
    motor_foc[MOTOR_2].dtcMax                                   = MOTOR2_DTC_MAX;
    motor_foc[MOTOR_2].dtcMin                                   = MOTOR2_DTC_MIN;
    //--- FOC - Duty cycles -----------------------------------------------------
    motor_foc[MOTOR_2].dtc_u                                    = 0.0f;
    motor_foc[MOTOR_2].dtc_v                                    = 0.0f;
    motor_foc[MOTOR_2].dtc_w                                    = 0.0f;
    //--- FOC - PI setpoint values ----------------------------------------------
    motor_foc[MOTOR_2].idRef                                    = 0.0f;
    motor_foc[MOTOR_2].iqRef                                    = 0.0f;
    //--- FOC - Initialize PI controller (Id) -----------------------------------
    motor_foc[MOTOR_2].piId.p_fb.ptr                            = (float32_t *)(&motor_foc[MOTOR_2].id);
    motor_foc[MOTOR_2].piId.p_set.ptr                           = (float32_t *)(&motor_foc[MOTOR_2].idRef);
    motor_foc[MOTOR_2].piId.p_sat.ptr                           = (float32_t *)(&motor_foc[MOTOR_2].motor_acq.vbus);
    motor_foc[MOTOR_2].piId.err                                 = 0.0f;
    motor_foc[MOTOR_2].piId.kp                                  = (float32_t)MOTOR2_PI_ID_KP_COEF;
    motor_foc[MOTOR_2].piId.ki                                  = (float32_t)MOTOR2_PI_ID_KI_COEF;
    motor_foc[MOTOR_2].piId.integral                            = 0.0f;
    motor_foc[MOTOR_2].piId.ff                                  = 0.0f;
    motor_foc[MOTOR_2].piId.out                                 = 0.0f;
    //--- FOC - Initialize PI controller (Iq) -----------------------------------
    motor_foc[MOTOR_2].piIq.p_fb.ptr                            = (float32_t *)(&motor_foc[MOTOR_2].iq);
    motor_foc[MOTOR_2].piIq.p_set.ptr                           = (float32_t *)(&motor_foc[MOTOR_2].iqRef);
    motor_foc[MOTOR_2].piIq.p_sat.ptr                           = (float32_t *)(&motor_foc[MOTOR_2].motor_acq.vbus);
    motor_foc[MOTOR_2].piIq.err                                 = 0.0f;
    motor_foc[MOTOR_2].piIq.kp                                  = (float32_t)MOTOR2_PI_IQ_KP_COEF;
    motor_foc[MOTOR_2].piIq.ki                                  = (float32_t)MOTOR2_PI_IQ_KI_COEF;
    motor_foc[MOTOR_2].piIq.integral                            = 0.0f;
    motor_foc[MOTOR_2].piIq.ff                                  = 0.0f;
    motor_foc[MOTOR_2].piIq.out                                 = 0.0f;
    //--- FOC - Initialize PD controller (Speed & position) ---------------------
    motor_foc[MOTOR_2].pdPosVel.p_fbTheta.ptr                   = (float32_t *)(&motor_foc[MOTOR_2].motor_enc.thetaAbsolute);
    motor_foc[MOTOR_2].pdPosVel.p_setTheta.ptr                  = (float32_t *)(&motor_foc[MOTOR_2].motor_cmd.posRef);
    motor_foc[MOTOR_2].pdPosVel.errTheta                        = 0.0f;
    motor_foc[MOTOR_2].pdPosVel.p_fbSpeed.ptr                   = (float32_t *)(&motor_foc[MOTOR_2].motor_enc.speed.speedMech[0]);
    motor_foc[MOTOR_2].pdPosVel.p_setSpeed.ptr                  = (float32_t *)(&motor_foc[MOTOR_2].motor_cmd.velRef);
    motor_foc[MOTOR_2].pdPosVel.errSpeed                        = 0.0f;
    motor_foc[MOTOR_2].pdPosVel.p_kp.ptr                        = (float32_t *)(&motor_foc[MOTOR_2].motor_cmd.kpCoeff);
    motor_foc[MOTOR_2].pdPosVel.p_kd.ptr                        = (float32_t *)(&motor_foc[MOTOR_2].motor_cmd.kdCoeff);
    motor_foc[MOTOR_2].pdPosVel.derivative                      = 0.0f;
    motor_foc[MOTOR_2].pdPosVel.p_ff.ptr                        = (float32_t *)(&motor_foc[MOTOR_2].motor_cmd.iqff);
    motor_foc[MOTOR_2].pdPosVel.p_sat.ptr                       = (float32_t *)(&motor_foc[MOTOR_2].motor_cmd.iSat);
    motor_foc[MOTOR_2].pdPosVel.out                             = 0.0f;
    //--- FOC - Q-axis resistance estimation ------------------------------------
    motor_foc[MOTOR_2].resEst                                   = 0.0f;
    //--- Resistance estimation low-pass filter ---------------------------------
    motor_foc[MOTOR_2].resEstFlt.a                              = MOTOR2_STATOR_RESISTOR_LPF_ALPHA;
    motor_foc[MOTOR_2].resEstFlt.one_minus_a                    = MOTOR2_STATOR_RESISTOR_LPF_ONE_M_ALPHA;

    //--- MOTOR_1 ---------------------------------------------------------------
    motor[MOTOR_1].motor_id                                     = MOTOR_1;
    //--- FOC structure address -------------------------------------------------
    motor[MOTOR_1].p_foc.ptr                                    = &motor_foc[MOTOR_1];
    //--- FSM motor initial state -----------------------------------------------
    motor[MOTOR_1].motor_state                                  = MOTOR_STATE_INIT;
    //--- Error message ---------------------------------------------------------
    motor[MOTOR_1].motor_error.all                              = 0;
    //---------------------------------------------------------------------------
    motor[MOTOR_1].clCycleNb                                    = 0;
    motor[MOTOR_1].itCnt                                        = 0;
    motor[MOTOR_1].itDone                                       = false;
    //--- DRV IO Config ---------------------------------------------------------
    motor[MOTOR_1].drvFaultNum                                  = MOTOR1_DRV_FAULT_NUM;
    motor[MOTOR_1].drvEnNum                                     = MOTOR1_DRV_EN_NUM;
    //---- PWM config address ---------------------------------------------------
    motor[MOTOR_1].epwmBaseAddr[CHANNEL_1]                      = MOTOR1_PWM1_BASE;
    motor[MOTOR_1].epwmBaseAddr[CHANNEL_2]                      = MOTOR1_PWM2_BASE;
    motor[MOTOR_1].epwmBaseAddr[CHANNEL_3]                      = MOTOR1_PWM3_BASE;
    //---- PWM command address --------------------------------------------------
    motor[MOTOR_1].p_cmdReg[CHANNEL_1].addr32b                  = MOTOR1_PWM1_CMD_ADDR;
    motor[MOTOR_1].p_cmdReg[CHANNEL_2].addr32b                  = MOTOR1_PWM2_CMD_ADDR;
    motor[MOTOR_1].p_cmdReg[CHANNEL_3].addr32b                  = MOTOR1_PWM3_CMD_ADDR;

    //--- MOTOR_2 ---------------------------------------------------------------
    motor[MOTOR_2].motor_id                                     = MOTOR_2;
    //--- FOC structure address -------------------------------------------------
    motor[MOTOR_2].p_foc.ptr                                    = &motor_foc[MOTOR_2];
    //--- FSM motor initial state -----------------------------------------------
    motor[MOTOR_2].motor_state                                  = MOTOR_STATE_INIT;
    //--- Error message ---------------------------------------------------------
    motor[MOTOR_2].motor_error.all                              = 0;
    //---------------------------------------------------------------------------
    motor[MOTOR_2].clCycleNb                                    = 0;
    motor[MOTOR_2].itCnt                                        = 0;
    motor[MOTOR_2].itDone                                       = false;
    //--- DRV IO Config ---------------------------------------------------------
    motor[MOTOR_2].drvFaultNum                                  = MOTOR2_DRV_FAULT_NUM;
    motor[MOTOR_2].drvEnNum                                     = MOTOR2_DRV_EN_NUM;
    //---- PWM config address ---------------------------------------------------
    motor[MOTOR_2].epwmBaseAddr[CHANNEL_1]                      = MOTOR2_PWM1_BASE;
    motor[MOTOR_2].epwmBaseAddr[CHANNEL_2]                      = MOTOR2_PWM2_BASE;
    motor[MOTOR_2].epwmBaseAddr[CHANNEL_3]                      = MOTOR2_PWM3_BASE;
    //---- PWM command address --------------------------------------------------
    motor[MOTOR_1].p_cmdReg[CHANNEL_1].addr32b              = MOTOR2_PWM1_CMD_ADDR;
    motor[MOTOR_1].p_cmdReg[CHANNEL_2].addr32b             = MOTOR2_PWM2_CMD_ADDR;
    motor[MOTOR_1].p_cmdReg[CHANNEL_3].addr32b             = MOTOR2_PWM3_CMD_ADDR;
}
