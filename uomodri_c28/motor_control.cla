/*
 * File name: motor_control.cla
 * Description: Source file containing motor control functions running on CLA processor.
 */

/***********************************************************************
* INCLUDES
***********************************************************************/
#include "f2838x_cla_typedefs.h"
#include "uomodri_shared.h"

/***********************************************************************
 * VARIABLES
 ***********************************************************************/
extern motor_t      motor_m1;
extern motor_t      motor_m2;
extern debug_t      debug_m1;
extern cmd_t        cmd_uomodri[];

/***********************************************************************
 * FUNCTIONS DECLARATION
 ***********************************************************************/
__attribute__((interrupt)) void adcCalib_Task(void);
__attribute__((interrupt)) void cmdNew_Task(void);
__attribute__((interrupt)) void motor1_Task(void);
__attribute__((interrupt)) void motor2_Task(void);
__attribute__((interrupt)) void Cla1Task5(void);
__attribute__((interrupt)) void Cla1Task6(void);
__attribute__((interrupt)) void Cla1Task7(void);
__attribute__((interrupt("background"))) void Cla1Task8(void);

/***********************************************************************
 * TASKS DEFINITION
 ***********************************************************************/
/**
 * @brief   ADC Calibration task. Run once by motor at startup to compensate ADC offset.
 */
__attribute__((interrupt)) void adcCalib_Task(void)
{
#ifdef DEBUG
    DBG_PIN1_SET;
#endif
    // Start ADC calibration on MOTOR_1 & MOTOR_2
    ADC_offsetCalib(&motor_m1);
    ADC_offsetCalib(&motor_m2);
    // Enable float rounding
    __asm(" MSETFLG RNDF32 = 1");
#ifdef DEBUG
    DBG_PIN1_CLEAR;
#endif
}

/**
 * @brief   Command update task. Run each time a new command is received on C28 processor or in timeout case.
 */
__attribute__((interrupt)) void cmdNew_Task(void)
{
#ifdef DEBUG
    DBG_PIN1_SET;
#endif
//    __mdebugstop();
    motor_m1.foc.cmd.posRef         = cmd_uomodri[MOTOR_1].posRef;
    if((cmd_uomodri[MOTOR_1].cmdField.all & CMD_POSITION_OFFSET_COMP) == CMD_POSITION_OFFSET_COMP)
        motor_m1.foc.cmd.posRef    += motor_m1.foc.enc.thetaIndexAbsolute;
    motor_m1.foc.cmd.velRef         = cmd_uomodri[MOTOR_1].velRef;
    motor_m1.foc.cmd.iqff           = cmd_uomodri[MOTOR_1].iqff;
    motor_m1.foc.cmd.kpCoeff        = cmd_uomodri[MOTOR_1].kpCoeff;
    motor_m1.foc.cmd.kdCoeff        = cmd_uomodri[MOTOR_1].kdCoeff;
    motor_m1.foc.cmd.iSat           = cmd_uomodri[MOTOR_1].iSat;
    motor_m1.foc.cmd.timeoutRef     = cmd_uomodri[MOTOR_1].timeoutRef;
    motor_m1.foc.cmd.cptTimeout     = cmd_uomodri[MOTOR_1].cptTimeout;
    motor_m1.foc.cmd.index          = cmd_uomodri[MOTOR_1].index;
    motor_m1.foc.cmd.cmdField.all   = cmd_uomodri[MOTOR_1].cmdField.all;
    motor_m1.foc.cmd.periphField.all= cmd_uomodri[MOTOR_1].periphField.all;

    motor_m2.foc.cmd.posRef         = cmd_uomodri[MOTOR_2].posRef;
    if((cmd_uomodri[MOTOR_2].cmdField.all & CMD_POSITION_OFFSET_COMP) == CMD_POSITION_OFFSET_COMP)
        motor_m2.foc.cmd.posRef    += motor_m2.foc.enc.thetaIndexAbsolute;
    motor_m2.foc.cmd.velRef         = cmd_uomodri[MOTOR_2].velRef;
    motor_m2.foc.cmd.iqff           = cmd_uomodri[MOTOR_2].iqff;
    motor_m2.foc.cmd.kpCoeff        = cmd_uomodri[MOTOR_2].kpCoeff;
    motor_m2.foc.cmd.kdCoeff        = cmd_uomodri[MOTOR_2].kdCoeff;
    motor_m2.foc.cmd.iSat           = cmd_uomodri[MOTOR_2].iSat;
    motor_m2.foc.cmd.timeoutRef     = cmd_uomodri[MOTOR_2].timeoutRef;
    motor_m2.foc.cmd.cptTimeout     = cmd_uomodri[MOTOR_2].cptTimeout;
    motor_m2.foc.cmd.index          = cmd_uomodri[MOTOR_2].index;
    motor_m2.foc.cmd.cmdField.all   = cmd_uomodri[MOTOR_2].cmdField.all;
    motor_m2.foc.cmd.periphField.all= cmd_uomodri[MOTOR_2].periphField.all;
#ifdef DEBUG
    DBG_PIN1_CLEAR;
#endif
}

/**
 * @brief   Motor_1 control task. Run @ 40kHz.
 *          - Read ADC (phase and Vbus) and encoder,
 *          - Perform FOC algorithm,
 *          - Generate the PWM commands
 */
__attribute__((interrupt)) void motor1_Task(void)
{
#ifdef DEBUG
    DBG_PIN0_SET;
#endif
//    __mdebugstop();
    // Motor control
    MOT_runControl(&motor_m1);
#ifdef DEBUG
    DBG_PIN0_CLEAR;
#endif
}

/**
 * @brief   Motor_2 control task. Run @ 40kHz.
 *          - Read ADC (phase and Vbus) and encoder,
 *          - Perform FOC algorithm,
 *          - Generate the PWM commands
 */
__attribute__((interrupt)) void motor2_Task(void)
{
#ifdef DEBUG
    DBG_PIN0_SET;
#endif
//    __mdebugstop();
    // Motor control
    MOT_runControl(&motor_m2);
#ifdef DEBUG
    DBG_PIN0_CLEAR;
#endif
}

/**
 * @brief   No task specified on task5
 */
__attribute__((interrupt)) void Cla1Task5(void)
{

}

/**
 * @brief   No task specified on task6
 */
__attribute__((interrupt)) void Cla1Task6(void)
{

}

/**
 * @brief   No task specified on task7
 */
__attribute__((interrupt)) void Cla1Task7(void)
{

}

/**
 * @brief   No task specified on task8
 */
__attribute__((interrupt("background"))) void Cla1Task8(void)
{
    if(debug_m1.ia != motor_m1.foc.acq.ia)
    {
        debug_m1.ia                     = motor_m1.foc.acq.ia;  // [A]
        debug_m1.ib                     = motor_m1.foc.acq.ib;                 // [A]
        debug_m1.ic                     = motor_m1.foc.acq.ic;                 // [A]
        debug_m1.vBus                   = motor_m1.foc.acq.vBus;               // [V]
        debug_m1.vExt                   = motor_m1.foc.acq.vExt;               // [V]

        debug_m1.enc_thetaElec          = motor_m1.foc.enc.thetaElec;          /*!< Angular electrical position  - [pu] */
        debug_m1.enc_thetaMech          = motor_m1.foc.enc.thetaMech[0];       /*!< Angular mechanical position  - [pu] */
        debug_m1.enc_thetaIndexRelative = motor_m1.foc.enc.thetaIndexRelative; /*!< Index mechanical angle */
        debug_m1.enc_thetaIndexAbsolute = motor_m1.foc.enc.thetaIndexAbsolute; /*!< First index mechanical angle */
        debug_m1.enc_thetaAbsolute      = motor_m1.foc.enc.thetaAbsolute;      /*!< Absolute angular position - [turns] */
        debug_m1.enc_turnNb             = motor_m1.foc.enc.turnNb;             /*!< Number of full turns (signed) */
        debug_m1.enc_thetaDir           = motor_m1.foc.enc.thetaDir;           /*!< Rotor direction - -1 = CCW/reverse, 1 = CW/forward */
        debug_m1.enc_flags              = motor_m1.foc.enc.flags;

        debug_m1.enc_speed_speedHigh    = motor_m1.foc.enc.speed.speedHigh;          /*!< High speed estimation -  [rad/s] - diff_angular * scaler = velocity */
        debug_m1.enc_speed_speedMech    = motor_m1.foc.enc.speed.speedMech[0];       /*!< Mechanical output speed - [rad/s] */
        debug_m1.enc_speed_speedElec    = motor_m1.foc.enc.speed.speedElec;          /*!< Electrical output speed (pole pairs integration) - [rad/s] */
        debug_m1.enc_speed_theta        = motor_m1.foc.enc.speed.theta[0];           /*!< Angular position of rotor - [pu] */

        debug_m1.cmd_posRef             = motor_m1.foc.cmd.posRef;
        debug_m1.cmd_velRef             = motor_m1.foc.cmd.velRef;
        debug_m1.cmd_iqff               = motor_m1.foc.cmd.iqff;
        debug_m1.cmd_kpCoeff            = motor_m1.foc.cmd.kpCoeff;
        debug_m1.cmd_kdCoeff            = motor_m1.foc.cmd.kdCoeff;
        debug_m1.cmd_iSat               = motor_m1.foc.cmd.iSat;
        debug_m1.cmd_cptTimeout         = motor_m1.foc.cmd.cptTimeout;
        debug_m1.cmd_index              = motor_m1.foc.cmd.index;
        debug_m1.cmd_cmdField           = motor_m1.foc.cmd.cmdField; /*!< Bit 0      : R/W - Enable system to start. No power on motors.         */
        debug_m1.cmd_periphField        = motor_m1.foc.cmd.periphField;   /*!< Bits 0   : R/W - DRV initialization went wrong             */

        debug_m1.sinTheta               = motor_m1.foc.sinTheta;           /*!< Sinus of the electrical rotor angle */
        debug_m1.cosTheta               = motor_m1.foc.cosTheta;           /*!< Cosine of the electrical rotor angle */
        debug_m1.ialpha                 = motor_m1.foc.ialpha;             /*!< Direct Clarke transform result - [A] */
        debug_m1.ibeta                  = motor_m1.foc.ibeta;              /*!< Direct Clarke transform result - [A] */
        debug_m1.id                     = motor_m1.foc.id;                 /*!< Filtered Direct Park transform result - [A] */
        debug_m1.iq                     = motor_m1.foc.iq;                 /*!< Filtered Quadrature Park transform result - [A] */
        debug_m1.ud                     = motor_m1.foc.ud;                 /*!< Inverse Park transform result - [V] */
        debug_m1.uq                     = motor_m1.foc.uq;                 /*!< Inverse Park transform result - [V] */
        debug_m1.ualpha                 = motor_m1.foc.ualpha;             /*!< Inverse Clarke transform result - [V] */
        debug_m1.ubeta                  = motor_m1.foc.ubeta;              /*!< Inverse Clarke transform result - [V] */
        debug_m1.ua                     = motor_m1.foc.ua;                 /*!< Phase commands - Channel a - [V] */
        debug_m1.ub                     = motor_m1.foc.ub;                 /*!< Phase commands - Channel b - [V] */
        debug_m1.uc                     = motor_m1.foc.uc;                 /*!< Phase commands - Channel c - [V] */
        debug_m1.dtc_u                  = motor_m1.foc.dtc_u;              /*!< Duty cycles on channel u - [pu] between -0.5 and 0.5 */
        debug_m1.dtc_v                  = motor_m1.foc.dtc_v;              /*!< Duty cycles on channel v - [pu] between -0.5 and 0.5 */
        debug_m1.dtc_w                  = motor_m1.foc.dtc_w;              /*!< Duty cycles on channel w - [pu] between -0.5 and 0.5 */
        debug_m1.idRef                  = motor_m1.foc.idRef;              /*!< PI controller set point values for D-axis current - [A] */
        debug_m1.iqRef                  = motor_m1.foc.iqRef;              /*!< PI controller set point values for Q-axis current - [A] */

        debug_m1.piId_err               = motor_m1.foc.piId.err;      /*!< Current error */
        debug_m1.piId_integral          = motor_m1.foc.piId.integral;           /*!< Integral term partial computation */
        debug_m1.piId_out               = motor_m1.foc.piId.out;                /*!< Controller output */

        debug_m1.piIq_err               = motor_m1.foc.piIq.err;      /*!< Current error */
        debug_m1.piIq_integral          = motor_m1.foc.piIq.integral;           /*!< Integral term partial computation */
        debug_m1.piIq_out               = motor_m1.foc.piIq.out;                /*!< Controller output */

        debug_m1.pdPosVel_errTheta      = motor_m1.foc.pdPosVel.errTheta;           /*!< Error position */
        debug_m1.pdPosVel_errSpeed      = motor_m1.foc.pdPosVel.errSpeed;           /*!< Error speed */
        debug_m1.pdPosVel_derivative    = motor_m1.foc.pdPosVel.derivative;         /*!< Derivative term partial computation */
        debug_m1.pdPosVel_out           = motor_m1.foc.pdPosVel.out;                /*!< Controller output */

        debug_m1.itCnt                  = motor_m1.itCnt;          /*!< Event counter incrementing on every IT call */
        debug_m1.motor_id               = motor_m1.id;             /*!< Motor identification */
        debug_m1.error                  = motor_m1.error;          /*!< Bit field for the error sources. */
        debug_m1.state                  = motor_m1.crState;        /*!< Current motor state for the FSM. */
    }
}

/* __MOTOR_CONTROL_CLA__ */
